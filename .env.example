# ==============================================================================
# HealthWatch Production Microservices - Template Environment Configuration
# Copy this file to .env.production on your server and customize the values:
#   cp .env.example .env.production
# ==============================================================================

# Server Domain or Public IP (e.g. healthwatch.example.com or 192.168.1.100)
DOMAIN_NAME=healthwatch.example.com

# Set to 'true' to enable automated Let's Encrypt HTTPS / SSL, or 'false' for HTTP
ENABLE_HTTPS=false
SSL_EMAIL=admin@example.com

# PostgreSQL Credentials
POSTGRES_USER=healthwatch_admin
POSTGRES_PASSWORD=replace_with_strong_password_here
POSTGRES_DB=healthwatch_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://healthwatch_admin:replace_with_strong_password_here@db:5432/healthwatch_db

# Backend Configuration
ENVIRONMENT=production
DEBUG=False
APP_NAME=HealthWatch
APP_VERSION=1.0.0
API_V1_STR=/api/v1
SECRET_KEY=replace_with_random_64_character_hex_string
WORKERS=4
BACKEND_CORS_ORIGINS=["http://healthwatch.example.com","https://healthwatch.example.com"]

# Default System Administrator Credentials
ADMIN_EMAIL=admin@healthwatch.org
ADMIN_PASSWORD=replace_with_secure_admin_password
ADMIN_NAME=System Administrator

# Frontend Configuration
VITE_APP_TITLE=HealthWatch Surveillance System
# Leave empty to utilize seamless same-origin relative path '/api' through Gateway
VITE_API_BASE_URL=
