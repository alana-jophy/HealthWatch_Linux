# ==============================================================================
# HealthWatch Frontend - Multi-Stage Production Dockerfile
# Stage 1: Build static assets via Vite & Node 20
# Stage 2: Serve optimized bundle via lightweight Nginx Alpine
# ==============================================================================

# ---- Stage 1: Build ----
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency manifests
COPY package*.json ./

# Install dependencies cleanly
RUN npm ci || npm install

# Copy application source code
COPY . .

# Build production bundle
RUN npm run build

# ---- Stage 2: Production Nginx Server ----
FROM nginx:alpine

# Remove default Nginx welcome page
RUN rm -rf /usr/share/nginx/html/*

# Copy built static bundle from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy optimized Nginx SPA configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose internal HTTP port
EXPOSE 80

# Health check
HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
    CMD wget -qO- http://localhost:80/healthz || exit 1

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
