# ==============================================================================
# HealthWatch Environment Configuration Example
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME=HealthWatch
APP_VERSION=1.0.0
API_V1_STR=/api/v1

# Security & Authentication
SECRET_KEY=change_this_to_a_super_secret_key_in_production_minimum_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=healthwatch_user
POSTGRES_PASSWORD=healthwatch_secure_password_123
POSTGRES_DB=healthwatch_db

# Assembled Database URL (psycopg2 for sync SQLAlchemy)
DATABASE_URL=postgresql://healthwatch_user:healthwatch_secure_password_123@db:5432/healthwatch_db

# Local Host connection URL (for running backend directly on host/WSL without Docker network)
# LOCAL_DATABASE_URL=postgresql://healthwatch_user:healthwatch_secure_password_123@localhost:5432/healthwatch_db

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE=HealthWatch Surveillance System
