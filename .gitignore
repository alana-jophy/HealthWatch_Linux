# ==============================================================================
# HealthWatch .gitignore
# ==============================================================================

# Environment files
.env
.env.local
.env.*.local
*.env

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# Python & Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
frontend/dist/
frontend/dist-ssr/
*.local

# Database & Volume Mounts
postgres_data/
*.sqlite3
*.db

# Mobile (Android / Kotlin)
mobile/.gradle/
mobile/build/
mobile/*/build/
mobile/local.properties
mobile/*.iml
mobile/.idea/
mobile/captures/
mobile/.externalNativeBuild
mobile/.cxx/

# AI / ML Model Artifacts & Data
ai/models/*.pkl
ai/models/*.joblib
ai/models/*.onnx
ai/data/
ai/notebooks/.ipynb_checkpoints/

# Docker Logs
*.log
docker-compose.override.yml
powershell.cmd
platform-tools/

