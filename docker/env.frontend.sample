# ==============================================================================
# HealthWatch Frontend Microservice - Sample Environment Configuration
# File: .env.frontend
# Container: healthwatch-frontend
# ==============================================================================

# Application Branding
VITE_APP_TITLE=HealthWatch Surveillance System
VITE_APP_VERSION=1.0.0

# API Gateway Route (Leave empty for relative reverse-proxy routing via Gateway)
# In production, all API calls route through the Gateway reverse proxy at /api
VITE_API_BASE_URL=

# Port Exposure (Internal container port handled by Nginx)
PORT=80
