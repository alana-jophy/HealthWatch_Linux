# ==============================================================================
# HealthWatch Microservices Full Stack - Production Master Environment File
# File: .env.production
# Used by: docker-compose.prod.yml and docker-compose.hub.yml
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Domain & Gateway Routing
# ------------------------------------------------------------------------------
DOMAIN_NAME=healthwatch.example.com
ENABLE_HTTPS=false
SSL_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL 16 + PostGIS 3.4)
# ------------------------------------------------------------------------------
POSTGRES_USER=healthwatch_admin
POSTGRES_PASSWORD=HealthWatch_Prod_Secret_Pass_2026!
POSTGRES_DB=healthwatch_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://healthwatch_admin:HealthWatch_Prod_Secret_Pass_2026!@db:5432/healthwatch_db

# ------------------------------------------------------------------------------
# 3. Backend Microservice (FastAPI + Gunicorn)
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=False
APP_NAME=HealthWatch
APP_VERSION=1.0.0
API_V1_STR=/api/v1
WORKERS=4
SECRET_KEY=9a4f2c1b8e7d3a5f6e8c0b2d4f6a8b1c3e5d7f9a1b3c5e7d9f1a3b5c7e9d1b3f
BACKEND_CORS_ORIGINS=["http://healthwatch.example.com","https://healthwatch.example.com","http://localhost"]
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24
ADMIN_EMAIL=admin@healthwatch.org
ADMIN_PASSWORD=Admin@HealthWatch2026
ADMIN_NAME=System Administrator

# ------------------------------------------------------------------------------
# 4. Frontend Microservice
# ------------------------------------------------------------------------------
VITE_APP_TITLE=HealthWatch Surveillance System
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# 5. Docker Hub Deployment Namespace (Optional for pulling from registry)
# ------------------------------------------------------------------------------
DOCKERHUB_USER=YOUR_DOCKERHUB_USERNAME
HEALTHWATCH_VERSION=1.0.0
