# ==============================================================================
# HealthWatch Backend - Hardened Production Dockerfile
# Production WSGI/ASGI execution via Gunicorn + Uvicorn Workers
# ==============================================================================

FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    PORT=8000 \
    WORKERS=4

# Install essential system dependencies (libpq, geos, proj for PostGIS/GeoAlchemy2)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libgeos-dev \
    libproj-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create application user for least-privilege security
RUN groupadd -r healthwatch && useradd -r -g healthwatch -d /app -s /sbin/nologin healthwatch

WORKDIR /app

# Copy dependency specifications
COPY requirements.txt .

# Install dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application source code
COPY . .

# Set proper permissions for the application user
RUN chown -R healthwatch:healthwatch /app

# Switch to non-root user
USER healthwatch

# Expose internal API port
EXPOSE 8000

# Health check endpoint
HEALTHCHECK --interval=15s --timeout=5s --retries=3 --start-period=20s \
    CMD curl -f http://localhost:8000/api/health || exit 1

# Production multi-worker execution
CMD ["sh", "-c", "exec gunicorn app.main:app -w ${WORKERS:-4} -k uvicorn.workers.UvicornWorker -b 0.0.0.0:${PORT:-8000} --timeout 120 --access-logfile - --error-logfile -"]
