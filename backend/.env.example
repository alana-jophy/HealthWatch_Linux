# Backend specific .env example
ENVIRONMENT=development
DEBUG=True
APP_NAME=HealthWatch
APP_VERSION=1.0.0
API_V1_STR=/api/v1

SECRET_KEY=change_this_to_a_super_secret_key_in_production_minimum_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=postgresql://healthwatch_user:healthwatch_secure_password_123@localhost:5432/healthwatch_db
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
