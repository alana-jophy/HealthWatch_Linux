# ==============================================================================
# HealthWatch Backend Microservice - Sample Environment Configuration
# File: .env.backend
# Container: healthwatch-backend
# ==============================================================================

# Core Application Settings
PORT=8000
WORKERS=4
ENVIRONMENT=production
DEBUG=False
APP_NAME=HealthWatch
APP_VERSION=1.0.0
API_V1_STR=/api/v1

# Security & Token Signing (Generate with: openssl rand -hex 32)
SECRET_KEY=9a4f2c1b8e7d3a5f6e8c0b2d4f6a8b1c3e5d7f9a1b3c5e7d9f1a3b5c7e9d1b3f
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24

# Database Connection (PostgreSQL 16 + PostGIS 3.4)
POSTGRES_USER=healthwatch_admin
POSTGRES_PASSWORD=HealthWatch_Prod_Secret_Pass_2026!
POSTGRES_DB=healthwatch_db
POSTGRES_SERVER=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://healthwatch_admin:HealthWatch_Prod_Secret_Pass_2026!@db:5432/healthwatch_db

# CORS Cross-Origin Resource Sharing (JSON array of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost","http://localhost:80","http://localhost:5173","https://healthwatch.example.com"]

# Surveillance Cadence Parameters
LOCATION_SAMPLING_INTERVAL_MINUTES=15
DEFAULT_MONITORING_DAYS=14
PROXIMITY_ALERT_THRESHOLD_METERS=50.0
STATIONARY_DRIFT_THRESHOLD_METERS=50.0
