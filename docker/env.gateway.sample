# ==============================================================================
# HealthWatch Gateway Microservice - Sample Environment Configuration
# File: .env.gateway
# Container: healthwatch-gateway
# ==============================================================================

# Fully Qualified Domain Name or Public IP (e.g. healthwatch.example.com or 192.168.1.100)
DOMAIN_NAME=healthwatch.example.com

# Enable Automated Let's Encrypt SSL/TLS Certificate ('true' for HTTPS, 'false' for HTTP)
ENABLE_HTTPS=false

# Contact Email for Let's Encrypt Certificate Expiry Alerts
SSL_EMAIL=admin@example.com

# Internal Routing Targets (Resolved automatically within docker bridge network)
FRONTEND_UPSTREAM=frontend:80
BACKEND_UPSTREAM=backend:8000
